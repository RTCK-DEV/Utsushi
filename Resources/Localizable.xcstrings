      }
    },
    "固有名詞が崩れやすい。語彙ヒント（辞書）と尤度に非対応なので一次認識には向かない": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proper nouns break easily. It supports neither vocabulary hints nor likelihoods, so it is unsuited to primary recognition"
          }
        }
      }
    },
    "固有名詞辞書": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proper noun dictionary"
          }
        }
